# ─────────────────────────────────────────────────────────────
# Le QG des Héros — variables d'environnement (EXEMPLE, aucun secret réel)
# Copier vers .env.local puis remplir. Ne jamais committer .env.local.
# ─────────────────────────────────────────────────────────────

# Base de données
# Sans DATABASE_URL : SQLite local (fichier ci-dessous), aucune installation requise.
SQLITE_PATH=./data/marvelhq.db
# Avec DATABASE_URL : PostgreSQL (ex. Supabase → Project Settings → Database → Connection string)
# DATABASE_URL=postgres://user:password@host:5432/postgres

# Sécurité des routes d'administration et du cron (/api/cron/ingest, /admin)
# Générer : openssl rand -hex 32
CRON_SECRET=change-me
ADMIN_TOKEN=change-me

# Fréquence d'ingestion par défaut (minutes) pour `npm run ingest -- --watch`
INGEST_INTERVAL_MINUTES=60

# TMDB (optionnel, gratuit, usage non commercial, attribution obligatoire)
# https://www.themoviedb.org/settings/api → "API Read Access Token"
# TMDB_READ_TOKEN=

# Traduction/résumé FR des articles anglophones via l'API Claude (optionnel, PAYANT à l'usage)
# Désactivé si vide : l'extrait original est alors affiché avec la mention "VO".
# ANTHROPIC_API_KEY=
# SUMMARY_MODEL=claude-opus-5-5   # modèle par défaut ; claude-haiku-5-5 est nettement moins cher

# YouTube Data API v3 (optionnel, gratuit, quota 10 000 unités/jour — 1 unité par vérification)
# Nécessaire pour la chaîne officielle @marvel (le flux RSS YouTube est interdit aux robots).
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
# YOUTUBE_API_KEY=
